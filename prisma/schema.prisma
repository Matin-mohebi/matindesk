generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  settings     UserSettings?
  projects     Project[]
  tasks        Task[]
  notes        Note[]
  bookmarks    Bookmark[]
  transactions Transaction[]
  events       CalEvent[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale       String  @default("fa") // fa | en | ar
  theme        String  @default("dark") // light | dark
  accent       String  @default("emerald")
  fontScale    Float   @default(1)
  currency     String  @default("IRT")
  monthlyBudget Float  @default(0)
  // GitHub integration (PAT is stored AES-256-GCM encrypted, never returned to client)
  githubPat    String?
  githubLogin  String?
  githubGistId String?
  lastBackupAt DateTime?
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#10b981")
  createdAt DateTime @default(now())

  tasks Task[]

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority    String    @default("medium") // low | medium | high | urgent
  status      String    @default("todo") // todo | in_progress | done
  dueDate     String? // yyyy-mm-dd
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("")
  color     String   @default("#10b981")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  url       String
  category  String   @default("general")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // income | expense
  amount    Float
  category  String
  note      String?
  date      String // yyyy-mm-dd
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}

model CalEvent {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  date             String // yyyy-mm-dd
  time             String? // HH:mm
  reminderMinutes  Int      @default(0)
  note             String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([date])
}
