{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatinDesk",
  "version": "1.0.0",
  "identifier": "app.matindesk.desktop",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "MatinDesk — میزکار ماتین",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 600,
        "url": "http://localhost:3000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
